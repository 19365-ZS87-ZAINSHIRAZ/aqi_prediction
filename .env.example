# API Keys
OPENAQ_API_KEY=your_openaq_api_key_here
WAQI_API_KEY=your_waqi_api_key_here

# Database Configuration - MongoDB Only (v1)
DB_TYPE=mongodb
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=air_quality_db

# Note: PostgreSQL support and Alert System will be enabled in v2 (management version)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=air_quality_db
# POSTGRES_USER=your_username
# POSTGRES_PASSWORD=your_password
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=your_twilio_number
# SENDGRID_API_KEY=your_sendgrid_key
# ALERT_EMAIL_FROM=alerts@airquality.pk

# Application Settings
APP_ENV=development  # development, production
LOG_LEVEL=INFO
DATA_REFRESH_INTERVAL=3600  # seconds

# Cities to Monitor
MONITORED_CITIES=Lahore,Karachi,Islamabad

# Alert Thresholds (for future v2)
AQI_ALERT_THRESHOLD=150
PM25_ALERT_THRESHOLD=55.4
PM10_ALERT_THRESHOLD=154
